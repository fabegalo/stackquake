{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the main window: Stackquake commands only. No plugin (network, files, shell) is exposed to the UI.",
  "windows": ["main"],
  "permissions": [
    "allow-get-setup-status",
    "allow-sign-in",
    "allow-sign-out",
    "allow-list-apps",
    "allow-refresh-apps",
    "allow-update-app-settings",
    "allow-sync-app",
    "allow-list-kpis",
    "allow-run-kpi",
    "allow-list-problems",
    "allow-get-problem",
    "allow-update-problem",
    "allow-fetch-problem-sample",
    "allow-open-kpi-folder",
    "allow-reset-local-data"
  ]
}
